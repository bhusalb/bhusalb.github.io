---
layout: default
---
{% assign paper = page.paper %}
<div class="post publications">
  <header class="post-header">
    <h1 class="post-title">{{ paper.title | escape }}</h1>
    <p class="post-description">
      {% for author in paper.authors %}
        {%- if author contains site.last_name and author contains site.first_name -%}
          <em>{{ author | escape }}</em>
        {%- else -%}
          {{ author | escape }}
        {%- endif -%}
        {%- unless forloop.last %}, {% endunless -%}
      {% endfor %}
    </p>
    <p class="periodical">
      {% if paper.venue -%}
        <em>{{ paper.venue | escape }}</em>,
      {% endif -%}
      {{- paper.year }}
    </p>
    <p>
      {{ paper.type_label | escape -}}
      {%- if paper.award_name %} · {{ paper.award_name | escape }}{% endif %}
    </p>
  </header>

  <article>
    <div class="links paper-actions">
      {% if paper.html_full_text %}
        <a href="{{ paper.html_full_text | escape }}" class="btn btn-sm z-depth-0">Read full text (HTML)</a>
      {% endif %}
      {% if paper.pdf %}
        <a href="{{ paper.pdf | escape }}" class="btn btn-sm z-depth-0">Read PDF</a>
      {% endif %}
      {% if paper.doi %}
        <a href="https://doi.org/{{ paper.doi | escape }}" class="btn btn-sm z-depth-0">DOI</a>
      {% endif %}
      {% if paper.arxiv %}
        <a href="https://arxiv.org/abs/{{ paper.arxiv | escape }}" class="btn btn-sm z-depth-0">arXiv</a>
      {% endif %}
      {% if paper.html %}
        <a href="{{ paper.html | escape }}" class="btn btn-sm z-depth-0">Paper online</a>
      {% elsif paper.source_url and paper.doi == null and paper.arxiv == null %}
        <a href="{{ paper.source_url | escape }}" class="btn btn-sm z-depth-0">Paper online</a>
      {% endif %}
      {% if paper.code %}
        <a href="{{ paper.code | escape }}" class="btn btn-sm z-depth-0">Code and resources</a>
      {% endif %}
      {% if paper.poster %}
        {% if paper.poster contains '://' %}
          <a href="{{ paper.poster | escape }}" class="btn btn-sm z-depth-0">Poster</a>
        {% else %}
          <a href="{{ paper.poster | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0">Poster</a>
        {% endif %}
      {% endif %}
      <a href="#cite" class="btn btn-sm z-depth-0">Cite this work</a>
      <a href="{{ paper.markdown_url | escape }}" class="btn btn-sm z-depth-0" download="{{ paper.key }}-summary.md">Summary (Markdown)</a>
    </div>

    {% if paper.summary %}
      <h2>What this work contributes</h2>
      <p>{{ paper.summary | escape }}</p>
    {% endif %}

    {% if paper.when_to_read %}
      <h2>When to read this work</h2>
      <p>{{ paper.when_to_read | escape }}</p>
    {% endif %}

    {% if paper.topics.size > 0 %}
      <p><strong>Topics:</strong> {{ paper.topics | join: ' · ' | escape }}</p>
    {% endif %}

    {% if paper.abstract %}
      <h2>Abstract</h2>
      <p>{{ paper.abstract | escape }}</p>
      {% if paper.abstract_source %}
        <p class="small">Abstract source: <a href="{{ paper.abstract_source | escape }}">Author-hosted paper</a>.</p>
      {% endif %}
    {% endif %}

    {% if paper.questions.size > 0 %}
      <section aria-labelledby="paper-questions">
        <h2 id="paper-questions">Questions about this paper</h2>
        {% for item in paper.questions %}
          <h3 id="question-{{ forloop.index }}">{{ item.question | escape }}</h3>
          <p>{{ item.answer | escape }}</p>
          <p class="small">
            Source: <a href="{{ item.source_url | escape }}">{{ item.source_label | escape }}</a>.
          </p>
        {% endfor %}
      </section>
    {% endif %}

    {% if paper.tutorials.size > 0 %}
      <h2>Tutorials and reading guides</h2>
      <ul>
        {% for tutorial in paper.tutorials %}
          <li>
            <a href="{{ tutorial.url | escape }}">{{ tutorial.title | escape }}</a>
            {%- if tutorial.description %} — {{ tutorial.description | escape }}{% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    <h2 id="cite">Cite this work</h2>
    <p>
      <a href="{{ paper.bibtex_url }}" download="{{ paper.key }}.bib">Download BibTeX</a>
      · <a href="{{ paper.ris_url }}" download="{{ paper.key }}.ris">Download RIS</a>
      {% if paper.publication_status == 'preprint' %} · This record describes a preprint.{% endif %}
    </p>
    {% highlight bibtex %}
    {{ paper.bibtex }}
    {% endhighlight %}

    <p>
      <a href="{{ '/publications/' | relative_url }}">&larr; All publications</a> ·
      <a href="{{ '/research/' | relative_url }}">Explore research topics</a>
    </p>
  </article>
</div>
