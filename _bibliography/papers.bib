@article{bhusal2026dpmuon,
  abbr = {arXiv},
  title = {Inner Momentum for Differentially Private Muon},
  author = {Bhusal, Bishnu and Vu, Minh and Southworth, Ben and Zollicoffer, Geigh and Chadha, Rohit and Bhattarai, Manish},
  journal = {arXiv preprint arXiv:2610.02738},
  year = {2026},
  month = oct,
  eprint = {2610.02738},
  archivePrefix = {arXiv},
  primaryClass = {cs.LG},
  url = {https://arxiv.org/abs/2610.02738},
  arxiv = {2610.02738},
  abstract = {Differentially private training clips each per-example gradient before adding noise. This clipping is radial for each example, yet unequal clipping factors can distort the relative singular-vector geometry of their average. Muon is particularly exposed to this effect, since its update is an approximate polar factor UV^T that depends only on the singular vectors that clipping can shift. To curb this degradation, we propose averaging each sampled example's Muon gradient over the current model and a short history of recent models before clipping. The clipped batch matrix then separates into a common rescaling and a covariance residual R between sampled gradients and clipping values, bounding the clipping-induced distortion directly. We further show that a finite Newton-Schulz iteration preserves the polar factor of its input under these spectral conditions, confirming that our correction survives orthogonalization. In private GPT-2 fine-tuning on E2E and DART at epsilon in {1, 2, 4, 8}, DP-Muon-IM improves BLEU and ROUGE-L over DP-Muon in every seed-matched comparison, and non-private diagnostics show 2-4\% lower pre-noise polar error.},
  bibtex_show = {true},
  selected = {true}
}

@article{pokharel2026ptm,
  abbr = {bioRxiv},
  title = {Learning Shared Residue Backgrounds and Modification-Specific Offsets for PTM Site Prediction},
  author = {Pokharel, Suresh and Bhusal, Bishnu},
  journal = {bioRxiv},
  year = {2026},
  month = aug,
  doi = {10.64898/2026.08.05.743079},
  url = {https://doi.org/10.64898/2026.08.05.743079},
  abstract = {Post-translational modifications (PTMs) are chemical changes added to proteins after translation. These changes affect protein function and regulation, and their disruption is linked to disease-associated mechanisms. Because experimentally validating all possible modification sites is impractical, many computational predictors have been developed for PTM site prediction. In this work, we study whether a shared model can represent common residue-background patterns while learning modification-specific background-to-positive offsets. We propose an anchor-guided rectified flow matching framework for multi-type PTM site prediction from protein language model embeddings. For each PTM-residue pair, the model builds residue-background anchors from PTM-compatible unannotated residues and positive anchors from experimentally annotated modified residues, and uses a rectified flow module to estimate a modification-conditioned background-to-positive offset. We evaluate the framework on a dbPTM-derived benchmark covering six commonly studied PTMs.},
  bibtex_show = {true}
}

