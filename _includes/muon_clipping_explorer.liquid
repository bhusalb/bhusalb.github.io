<style>
.muon-explorer {
  margin: 1rem 0 2rem;
  padding: 1.25rem;
  border: 1px solid var(--global-divider-color);
  border-radius: 8px;
}
.muon-explorer h3 {
  font-size: 1.25rem;
}
.muon-explorer input[type=range] {
  display: block;
  width: 100%;
  min-height: 44px;
  accent-color: var(--global-theme-color);
}
.muon-explorer .muon-explorer-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1.25rem;
}
.muon-explorer button {
  min-height: 44px;
  padding: 0.4rem 0.75rem;
  color: var(--global-text-color);
  background: var(--global-card-bg-color);
  border: 1px solid var(--global-divider-color);
  border-radius: 4px;
}
.muon-explorer .muon-explorer-values {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  gap: 1rem;
  margin-bottom: 1rem;
}
.muon-explorer .muon-explorer-values p {
  margin-bottom: 0.5rem;
}
.muon-explorer .muon-explorer-values output {
  font-size: 1.5rem;
  font-variant-numeric: tabular-nums;
}
.muon-explorer .muon-explorer-matrix {
  border-left: 2px solid var(--global-text-color);
  border-right: 2px solid var(--global-text-color);
  font-family: monospace;
  font-variant-numeric: tabular-nums;
}
.muon-explorer .muon-explorer-matrix td {
  padding: 0.1rem 0.5rem;
}
.muon-explorer .muon-explorer-note {
  margin-bottom: 0;
  color: var(--global-text-color-light);
  font-size: 0.875rem;
}
</style>
<div class="muon-explorer" data-muon-explorer hidden>
  <h3>Try a clipping threshold</h3>
  <label for="muon-clipping-threshold">Threshold C: <output data-muon-threshold aria-live="off">1.00</output></label>
  <input id="muon-clipping-threshold" type="range" min="0.25" max="4.5" step="0.05" value="1" aria-describedby="muon-threshold-help">
  <p id="muon-threshold-help">Move the slider to change how strongly each example is clipped.</p>
  <div class="muon-explorer-presets">
    <button type="button" data-muon-preset="1">Example: C = 1</button>
    <button type="button" data-muon-preset="4">No clipping: C = 4</button>
  </div>
  <div class="muon-explorer-values">
    <div>
      <p>Mean after clipping</p>
      <table class="muon-explorer-matrix" aria-label="Mean matrix after clipping">
        <tbody>
          <tr>
            <td data-muon-a>0.5000</td>
            <td data-muon-b>0.3536</td>
          </tr>
          <tr>
            <td>0.0000</td>
            <td data-muon-d>0.3536</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div>
      <p>Polar rotation</p>
      <output data-muon-angle aria-live="off">−22.50°</output>
    </div>
    <div>
      <p>Change from original</p>
      <output data-muon-change aria-live="off">11.19°</output>
    </div>
  </div>
  <p class="muon-explorer-note">Rounded values for the same two example matrices. No privacy noise is added.</p>
  <span class="sr-only" data-muon-status role="status"></span>
</div>
<script defer src="{{ '/assets/js/muon_clipping_explorer.js' | relative_url | bust_file_cache }}"></script>
