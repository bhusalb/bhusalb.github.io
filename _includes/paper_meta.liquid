{% assign paper = page.paper %}
{% assign owner_name = site.first_name | append: ' ' | append: site.last_name %}
<!-- Google Scholar (Highwire Press) citation metadata -->
<meta name="citation_title" content="{{ paper.title | escape }}">
{% for author in paper.authors %}
  <meta name="citation_author" content="{{ author | escape }}">
  {% if author == owner_name and site.orcid_id %}<meta name="citation_author_orcid" content="https://orcid.org/{{ site.orcid_id }}">{% endif %}
{% endfor %}
<meta name="citation_publication_date" content="{{ paper.date }}">
{% if paper.bibliographic_type == 'conference-paper' %}
  <meta name="citation_conference_title" content="{{ paper.venue | escape }}">
{% elsif paper.bibliographic_type == 'book-chapter' %}
  <meta name="citation_inbook_title" content="{{ paper.venue | escape }}">
{% elsif paper.bibliographic_type == 'journal-article' %}
  <meta name="citation_journal_title" content="{{ paper.venue | escape }}">
{% endif %}
{% if paper.publisher %}<meta name="citation_publisher" content="{{ paper.publisher | escape }}">{% endif %}
{% if paper.volume %}<meta name="citation_volume" content="{{ paper.volume }}">{% endif %}
{% if paper.issue %}<meta name="citation_issue" content="{{ paper.issue }}">{% endif %}
{% if paper.firstpage %}<meta name="citation_firstpage" content="{{ paper.firstpage }}">{% endif %}
{% if paper.lastpage %}<meta name="citation_lastpage" content="{{ paper.lastpage }}">{% endif %}
{% if paper.article_number %}<meta name="citation_article_number" content="{{ paper.article_number }}">{% endif %}
{% if paper.isbn %}<meta name="citation_isbn" content="{{ paper.isbn }}">{% endif %}
{% if paper.doi %}<meta name="citation_doi" content="{{ paper.doi }}">{% endif %}
{% if paper.arxiv %}<meta name="citation_arxiv_id" content="{{ paper.arxiv }}">{% endif %}
{% if paper.keywords %}<meta name="citation_keywords" content="{{ paper.keywords | escape }}">{% endif %}
{% if paper.abstract %}<meta name="citation_abstract" content="{{ paper.abstract | escape }}">{% endif %}
{% if paper.pdf %}<meta name="citation_pdf_url" content="{{ paper.pdf | escape }}">{% endif %}
<meta name="citation_abstract_html_url" content="{{ paper.url }}">
<meta name="dc.type" content="{{ paper.type_label }}">
<meta name="dc.identifier" content="{{ paper.identifier | escape }}">
<link rel="alternate" type="application/x-bibtex" href="{{ paper.bibtex_url }}" title="BibTeX citation">
<link rel="alternate" type="application/x-research-info-systems" href="{{ paper.ris_url }}" title="RIS citation">
<link rel="alternate" type="text/markdown" href="{{ paper.markdown_url }}" title="Publication summary and citation (Markdown)">

<script type="application/ld+json">
  {{ paper.schema | jsonify | replace: '</', '<\/' }}
</script>
